# Resend. From must use a domain verified in Resend.
# The key stays in updates/.env, which is gitignored.
RESEND_API_KEY=
RESEND_FROM=Homelab <homelab@hgoncalves.uk>
RESEND_TO=
# Uptime Kuma push monitor: the part of its push URL after /api/push/.
# Blank sends no heartbeat.
KUMA_PUSH_TOKEN=
# ntfy topic that gets a push for each update. Anyone who knows the name can
# read it, so make it long and random. Blank sends no push.
NTFY_TOPIC=
# Another ntfy server; blank is https://ntfy.sh.
NTFY_URL=
