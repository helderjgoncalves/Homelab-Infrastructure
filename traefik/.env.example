# Traefik — environment template
# Copy to `.env` (gitignored) and fill in the values.

# Let's Encrypt account email.
ACME_EMAIL=

# Cloudflare API token, Zone:DNS:Edit on the zone (DNS-01 challenge).
CF_DNS_API_TOKEN=

# Listen ports. 80/443 in production; any free pair (e.g. 8880/8443 — 8080
# is taken by QTS) to test a change alongside the live instance.
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Uncomment to test against Let's Encrypt staging (untrusted certs, no rate
# limits). Delete acme/acme.json before switching back to production.
#ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
