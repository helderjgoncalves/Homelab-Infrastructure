# Pi-hole — environment template.
# Copy to `.env` (gitignored) for shell-deploys, or set the same keys in
# Dockge's stack environment-variables UI.

# ---- Stack runtime ---------------------------------------------------------

# LAN IP assigned to Pi-hole's macvlan interface. Must be:
#   - inside PIHOLE_LAN_SUBNET below
#   - outside the router's DHCP pool (reserve it statically)
#   - free on the LAN
PIHOLE_IP=

# Web admin / API password (FTLCONF_webserver_api_password).
PIHOLE_WEBPASSWORD=

# ---- macvlan network (used by bootstrap.sh) --------------------------------
# bootstrap.sh creates the `macvlan_pihole` network from these values once
# per host. Re-running is idempotent.

# CIDR for the LAN that Pi-hole sits on, e.g. 192.168.1.0/24
PIHOLE_LAN_SUBNET=

# Default gateway for that LAN, e.g. 192.168.1.1
PIHOLE_LAN_GATEWAY=

# Parent network interface on the host (e.g. eth0, bond0).
# On QNAP, find with: `ip -o link show | awk -F': ' '{print $2}'`
PIHOLE_PARENT_IFACE=

# Address for the host's macvlan shim leg. Without it the host kernel drops
# traffic to its own macvlan children, so the NAS cannot use Pi-hole for DNS.
# Any free IP inside PIHOLE_LAN_SUBNET that is NOT PIHOLE_IP and NOT the
# gateway, e.g. 192.168.1.253. Required by bootstrap.sh and post-pihole.sh.
PIHOLE_SHIM_IP=

# ---- Host-specific paths ---------------------------------------------------
# Directory containing the `docker` CLI on this host. Prepended to PATH by
# pihole-diag.sh so `docker ps` works when the QNAP shell env is minimal.
# Find with: `dirname "$(which docker)"`
CS_DOCKER_BIN=

# ---- Autorun install (used by install-autorun.sh) --------------------------
# Optional absolute path to an extra script the DOM autorun hook should run
# after the Pi-hole watchdog (e.g. a swap-disable helper on another volume).
# Leave empty to skip. Substituted into autorun.sh at install time, so this
# NAS's directory layout never lands in the tracked file.
AUTORUN_SWAP_SCRIPT=
