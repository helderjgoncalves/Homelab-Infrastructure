# AdGuard Home — environment template.
# Copy to `.env` (gitignored), or set the same keys in Dockge's stack env UI.
# Also consumed by scripts/render-config.sh; re-run it after any change here.

# ---- Stack runtime ---------------------------------------------------------

# LAN IP for AdGuard Home's macvlan interface: inside the macvlan subnet,
# outside the DHCP pool, free on the LAN. Must equal DNS_IP in nas-host/.env —
# that is the address the shim routes and the NAS resolves through.
ADGUARD_IP=

# Existing external macvlan network to attach to (created by
# nas-host/scripts/bootstrap.sh). Same value as MACVLAN_NETWORK in
# nas-host/.env; the live name predates the move off Pi-hole.
MACVLAN_NETWORK=macvlan_pihole

# ---- Admin credentials -----------------------------------------------------

ADGUARD_ADMIN_USER=admin

# Web UI password as a bcrypt hash, not plaintext — shipping a hash is what
# lets the rest of the config be committed. Generate with:
#
#   docker run --rm httpd:alpine htpasswd -B -n -b '' 'your-password' | cut -d: -f2
#
# Wrap the hash in SINGLE QUOTES. It contains `$`, which Compose's dotenv
# parser would otherwise try to expand; single-quoted values are left literal,
# and render-config.sh strips the quotes.
ADGUARD_ADMIN_PASSWORD_HASH=

# ---- LAN topology ----------------------------------------------------------

# CIDR allowed to query this resolver, e.g. 192.168.1.0/24. Becomes
# dns.allowed_clients — what stops it being an open resolver on the LAN.
LAN_SUBNET=

# Router, e.g. 192.168.1.1. Upstream for LOCAL_DOMAIN and private-PTR resolver.
LAN_GATEWAY=

# Local domain served by the router, e.g. `lan`. Not sent over DoH.
LOCAL_DOMAIN=lan

# ---- Local service records -------------------------------------------------

# Public zone whose hostnames are answered locally with NAS_IP, e.g.
# example.com. Produces one split-horizon rewrite per service.
PUBLIC_ZONE=

# Reverse-proxy LAN address those rewrites answer with, e.g. 192.168.1.206.
NAS_IP=
