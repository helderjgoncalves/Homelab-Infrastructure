# Nginx Proxy Manager — environment template
# Copy to `.env` (gitignored) and fill in the values.
#
# Dockge reads this `.env` directly from the stack folder when starting
# the compose project, so values set here take effect on deploy.

# Upstream DNS resolver for the NPM container — typically Pi-hole's LAN IP,
# so proxied hostnames resolve to local services.
LAN_DNS_IP=
