# ntfy — environment template.
# Copy to `.env` (gitignored) and fill in the value below.

# Public hostname for this ntfy instance, WITHOUT the scheme. It becomes
# NTFY_BASE_URL (https://${NTFY_DOMAIN}) and must match the hostname served by
# NPM / Cloudflare Tunnel, otherwise iOS push, attachment links and topic URLs
# are generated wrong. e.g. ntfy.example.com
NTFY_DOMAIN=
