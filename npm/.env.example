# Nginx Proxy Manager — environment template
# Copy to `.env` (gitignored) and fill in the host path.
#
# When deploying via Dockge (Git-backed stack), the .env in the repo is
# NOT used — set this as an "Environment variable" in the Dockge stack UI
# instead. The compose file reads it by the same name either way.

# Host base directory for NPM persistent state.
# The compose file mounts ${NPM_DIR}/data and ${NPM_DIR}/letsencrypt.
NPM_DIR=
