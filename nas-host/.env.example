# NAS host plumbing — environment template.
# Copy to `.env` (gitignored). Read by every script in scripts/.

# ---- macvlan network (created by bootstrap.sh) -----------------------------

# Docker network the DNS container attaches to (adguard/ MACVLAN_NETWORK).
# The live network on this NAS is still called `macvlan_pihole` from before
# the move to AdGuard Home. Keep that name: renaming means recreating the
# network with the DNS container detached.
MACVLAN_NETWORK=macvlan_pihole

# CIDR for the LAN, e.g. 192.168.1.0/24
LAN_SUBNET=

# Default gateway for that LAN, e.g. 192.168.1.1
LAN_GATEWAY=

# Parent network interface on the host (e.g. eth0, bond0).
# On QNAP, find with: `ip -o link show | awk -F': ' '{print $2}'`
PARENT_IFACE=

# ---- DNS container ---------------------------------------------------------

# LAN IP of the DNS container on the macvlan — must equal adguard/ ADGUARD_IP.
# The shim routes it, and /etc/resolv.conf points the NAS at it.
DNS_IP=

# Address for the host's macvlan shim leg. Without it the host kernel drops
# traffic to its own macvlan children, so the NAS cannot use the DNS container.
# Any free IP inside LAN_SUBNET that is NOT DNS_IP and NOT the gateway,
# e.g. 192.168.1.253.
SHIM_IP=

# Container name, used by dns-diag.sh for health and status checks.
DNS_CONTAINER=adguard

# ---- Host-specific paths ---------------------------------------------------

# Directory containing the `docker` CLI on this host. Prepended to PATH by
# dns-diag.sh so `docker ps` works when the QNAP shell env is minimal.
# Find with: `dirname "$(which docker)"`
CS_DOCKER_BIN=

# ---- Autorun install (used by install-autorun.sh) --------------------------
# Optional absolute path to an extra script the DOM autorun hook should run
# after the DNS watchdog (e.g. a swap-disable helper on another volume).
# Leave empty to skip. Substituted into autorun.sh at install time, so this
# NAS's directory layout never lands in the tracked file.
AUTORUN_SWAP_SCRIPT=
