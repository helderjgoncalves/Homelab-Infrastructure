# Dockge — environment template.
# Copy to `.env` (gitignored) and fill in the value below.

# Parent directory holding compose stacks (one subfolder per stack). This is
# the repo root as checked out on the Docker host, because each stack folder
# *is* its Dockge stack dir.
#
# The compose file mounts this path to the identical path inside the container
# (${STACKS_DIR}:${STACKS_DIR}). That is deliberate: Dockge shells out to
# `docker compose`, and the daemon resolves the paths on the host, so an
# asymmetric mount would break every stack it manages.
#
# On the current NAS this is /share/CACHEDEV2_DATA/SSDShared
STACKS_DIR=
