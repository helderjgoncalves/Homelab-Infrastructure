# media-automation — environment template
# Copy to `.env` (gitignored) for shell deploys, or set the same keys in
# Dockge's stack environment-variables UI for Git-backed deploys.

# ---- Storage (host path) ---------------------------------------------------
# Single data root holding both torrents/ and media/. Must be ONE filesystem
# so Radarr/Sonarr can hardlink instead of copy. Radarr, Sonarr and
# qBittorrent all mount it as /data.
DATA_DIR=

# Legacy qBittorrent mounts, used only by the gitignored
# docker-compose.override.yml. Keep them while torrents added before /data
# still seed from these folders; drop them afterwards.
QBT_DOWNLOADS_DIR=
QBT_MUSIC_DIR=
QBT_MOVIES_DIR=
QBT_TV_DIR=
