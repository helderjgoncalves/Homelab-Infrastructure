# qBittorrent — environment template
# Copy to `.env` (gitignored) for shell deploys, or set the same keys in
# Dockge's stack environment-variables UI for Git-backed deploys.

# ---- Storage paths (host paths) -------------------------------------------
# Downloads destination. Big slow storage (HDD) is fine; this is also the
# final resting place — there's no separate "completed" path.
QBT_DOWNLOADS_DIR=

# Existing media trees, mounted read-write so qBittorrent can seed/move into
# them. Point each at the LAN share that already holds the library.
QBT_MUSIC_DIR=
QBT_MOVIES_DIR=
QBT_TV_DIR=
