# Cloudflare Tunnel — environment template
# Copy to `.env` (gitignored) and fill in the real token.
#
# Get the token from the Cloudflare dashboard:
#   Zero Trust  ->  Networks  ->  Tunnels  ->  <your tunnel>  ->  Configure
#   ->  Install connector  ->  copy the value after `--token`.
#
# Treat this token like a password: it grants connector access to your tunnel.

TUNNEL_TOKEN=
