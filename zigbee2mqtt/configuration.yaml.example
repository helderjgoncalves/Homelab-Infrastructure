# Copy to data/configuration.yaml. Zigbee2MQTT rewrites the copy.
# Passwords live in data/secret.yaml (gitignored with the rest of data/).
mqtt:
  server: mqtt://127.0.0.1:1883
  user: zigbee
  password: '!secret.yaml mqtt_password'
  base_topic: zigbee2mqtt

serial:
  # SONOFF Dongle-M, Zigbee coordinator mode. adapter ember, not the
  # deprecated ezsp driver. Software flow control: do not set rtscts.
  port: tcp://192.168.1.109:6638
  adapter: ember
  baudrate: 115200

frontend:
  enabled: true
  port: 8210
  host: 127.0.0.1
  url: https://z2m.hgoncalves.uk
  auth_token: '!secret.yaml auth_token'

homeassistant:
  enabled: true

advanced:
  channel: 25
  log_level: info

permit_join: false
