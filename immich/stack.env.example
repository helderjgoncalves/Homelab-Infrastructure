# Immich — environment template
# Copy to `stack.env` (gitignored) for shell deploys, or set the same keys
# in Dockge's stack environment-variables UI for Git-backed deploys.
#
# Reference: https://immich.app/docs/install/environment-variables

# ---- Timezone --------------------------------------------------------------
TZ=Europe/Lisbon

# ---- Image -----------------------------------------------------------------
# `release` is rolling latest. Pin a specific tag (e.g. v1.118.0) for
# reproducible deploys; upgrades become a deliberate Git commit.
IMMICH_VERSION=release

# ---- Storage paths (host paths) -------------------------------------------

# Originals / uploads — typically on big slow storage (HDD/RAID).
UPLOAD_LOCATION=

# Derived/operational data — typically on fast storage (SSD).
# The compose mounts these subdirectories:
#   ${SSD_LOCATION}/thumbs
#   ${SSD_LOCATION}/backups
#   ${SSD_LOCATION}/profile
#   ${SSD_LOCATION}/encoded-video
#   ${SSD_LOCATION}/postgres        <-- Postgres data dir
SSD_LOCATION=

# Base directory for external photo libraries (per-user folders mounted
# read-only into Immich for indexing). The compose mounts:
#   ${IMMICH_HOMES_BASE}/jose/Fotos
#   ${IMMICH_HOMES_BASE}/jose/Fotos Telemóvel
#   ${IMMICH_HOMES_BASE}/ludovina/Fotos Telemóvel
#   ${IMMICH_HOMES_BASE}/hgo/Photos
IMMICH_HOMES_BASE=

# ---- Database --------------------------------------------------------------
# Used by the Postgres container AND by immich-server to connect.
# DB_PASSWORD must not be empty — Immich refuses to start otherwise.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=

# ---- Reverse proxy / network ----------------------------------------------
# Tells Immich which upstream IPs are allowed to set X-Forwarded-* headers,
# so audit logs, rate limits and "last seen" track the REAL client IP rather
# than the proxy's. Without this, every connection looks like it's from NPM.
#
# 127.0.0.1     — NPM running with network_mode: host on the same NAS.
# 172.16.0.0/12 — Docker default bridge subnets, in case NPM ever moves
#                 into a Docker network later.
# Add the proxy IP only — do NOT add LAN ranges, or spoofed headers from
# anywhere on the LAN would be honoured.
IMMICH_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# ---- Security headers (Helmet) --------------------------------------------
# Enables Cross-Origin headers, X-Frame-Options, Referrer-Policy, etc.
#   false (default) — Helmet OFF. Not what we want for a public service.
#   true            — Helmet ON, using Immich's built-in server/helmet.json.
#   /path/to.json   — custom Helmet config (bind-mounted into the container).
# A container recreate (`docker compose up -d --force-recreate`) is required
# when changing this value; a plain restart will not pick it up.
IMMICH_HELMET_FILE=true
